{
  "name": "spike-prime-c",
  "displayName": "SPIKE Prime C",
  "description": "Beginner-friendly VS Code workflow for building and running SPIKE Prime C projects.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:spikePrimeC.newProject",
    "onCommand:spikePrimeC.build",
    "onCommand:spikePrimeC.upload",
    "onCommand:spikePrimeC.buildAndRun",
    "onCommand:spikePrimeC.selectHub",
    "onCommand:spikePrimeC.configureSpikeRt",
    "onCommand:spikePrimeC.openSpikeRtBuild",
    "onView:spikePrimeC.hub",
    "onView:spikePrimeC.examples"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spikePrimeC.newProject",
        "title": "SPIKE Prime: New Project"
      },
      {
        "command": "spikePrimeC.build",
        "title": "SPIKE Prime: Build"
      },
      {
        "command": "spikePrimeC.upload",
        "title": "SPIKE Prime: Upload"
      },
      {
        "command": "spikePrimeC.buildAndRun",
        "title": "SPIKE Prime: Build and Run"
      },
      {
        "command": "spikePrimeC.selectHub",
        "title": "SPIKE Prime: Select Hub"
      },
      {
        "command": "spikePrimeC.configureSpikeRt",
        "title": "SPIKE Prime: Configure SPIKE-RT Tools"
      },
      {
        "command": "spikePrimeC.openSpikeRtBuild",
        "title": "SPIKE Prime: Open SPIKE-RT Build Folder"
      }
    ],
    "configuration": {
      "title": "SPIKE Prime C",
      "properties": {
        "spikePrimeC.makeCommand": {
          "type": "string",
          "default": "make",
          "description": "Shell command used to build SPIKE Prime C projects. Supports ${workspaceFolder}."
        },
        "spikePrimeC.uploadCommand": {
          "type": "string",
          "default": "spike-upload ${outputFile}",
          "description": "Shell command used to upload compiled firmware to the SPIKE Prime Hub. Supports ${workspaceFolder} and ${outputFile}."
        },
        "spikePrimeC.outputFile": {
          "type": "string",
          "default": "build/output.bin",
          "description": "Firmware file used by upload commands."
        },
        "spikePrimeC.uploadRunsInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Run upload in a VS Code terminal so USB flashing tools and sudo prompts can interact with the user."
        },
        "spikePrimeC.showDfuInstructions": {
          "type": "boolean",
          "default": true,
          "description": "Show DFU-mode instructions before uploading to the SPIKE Prime Hub."
        },
        "spikePrimeC.spikeRtRoot": {
          "type": "string",
          "default": "/Users/jax/spike-rt",
          "description": "Path to the local SPIKE-RT checkout."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spikePrimeC",
          "title": "SPIKE Prime",
          "icon": "media/spike.svg"
        }
      ]
    },
    "views": {
      "spikePrimeC": [
        {
          "id": "spikePrimeC.hub",
          "name": "Hub"
        },
        {
          "id": "spikePrimeC.examples",
          "name": "Examples"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  },
  "devDependencies": {}
}
